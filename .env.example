# Copy to .env; never publish this file with real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
HOST=127.0.0.1
PORT=3000
# Required for every non-loopback bind; also recommended behind a local reverse proxy.
REVIEW_ACCESS_TOKEN=
# Exact origins, comma-separated, no trailing slash or path. Never use *.
# ALLOWED_ORIGINS=https://your-name.github.io,https://photos.example.com
ALLOWED_ORIGINS=
REVIEW_RATE_LIMIT=10
REVIEW_RATE_WINDOW_MS=60000
REVIEW_CONCURRENCY=2
REVIEW_TIMEOUT_MS=30000

# Optional Azure OpenAI provider, separate from Gemini. Leave ALL four blank until provisioned.
# Choose an actually available vision + structured-output deployment in your subscription.
# API uses the stable /openai/v1/chat/completions route; no preview API version is required.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
# REVIEW_ACCESS_TOKEN is mandatory for Azure, including localhost. Never put the API key in the UI.
AZURE_REVIEW_TIMEOUT_MS=120000
AZURE_REVIEW_MAX_COMPLETION_TOKENS=8192
# Counts attempts before dispatch, including errors/cancellations. Does NOT represent a dollar cap.
AZURE_REVIEW_MONTHLY_LIMIT=100
# Persistent private directory, shared by all backend instances; never publish/delete to reset usage.
# Ephemeral hosting without persistent shared storage is NOT suitable for this guard.
AZURE_REVIEW_BUDGET_DIR=.azure-budget

# Separate local-only Ollama provider. Blank means enabled on loopback, disabled on public HOST.
# Setting true on a public HOST is rejected. No Gemini key is needed by these routes.
LOCAL_REVIEW_ENABLED=
# Use the explicit non-thinking Instruct variant; choose 2b-instruct on an 8 GB Mac.
QWEN_MODEL=qwen3-vl:4b-instruct
LOCAL_REVIEW_TIMEOUT_MS=600000
# Separate bearer token, REQUIRED for deployed websites or any other cross-origin local client,
# including /api/review/local/status. Also add that site's exact origin to ALLOWED_ORIGINS above.
# Trusted same-companion-origin browser calls do not need this token.
# If set, originless clients must provide it; no token is disclosed to the browser automatically.
LOCAL_REVIEW_ACCESS_TOKEN=
# Ollama is fixed at http://127.0.0.1:11434; no custom upstream URL is supported.
# Set these on the Ollama process itself, NOT just this Node server:
# OLLAMA_NO_CLOUD=1
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_HOST=127.0.0.1:11434
